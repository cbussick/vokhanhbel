{
  // Vercel compiles API functions from this root config and does not follow project references.
  // Keep these Vercel-facing Node ESM options aligned with tsconfig.node.json.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    // Vercel's function compiler does not find `@types/node` by walking up from each function, even
    // though the project build resolves it moments earlier on the same machine. Pinning the type
    // root relative to this file tells it where the types already are.
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }]
}
