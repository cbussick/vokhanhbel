{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "all",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    "coverage",
    "dist",
    "drizzle/meta",
    "node_modules",
    "package-lock.json",
    "src/routeTree.gen.ts",
    ".env.example",
    ".scratch",
    "docs/agents/triage-labels.md"
  ]
}
